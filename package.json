{
  "name": "pmd-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "PMD Dashboard - backend-agnostic real-time shift production tracking for Precision Moulding Department",
  "type": "module",
  "scripts": {
    "predev": "node scripts/check-deps.mjs",
    "dev": "vite",
    "prebuild": "node scripts/check-deps.mjs --strict",
    "build": "npm run build:mes && npm --prefix assembly run build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run build && node scripts/deploy-assets.mjs",
    "build:mes": "tsc --noEmit && vite build",
    "test:assembly": "npm --prefix assembly test",
    "setup:assembly": "npm --prefix assembly ci"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^4.1.10"
  }
}
